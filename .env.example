# RASQ-Ai environment reference. Copy to `.env` for local runs; never commit real values.
# All RASQ_* variables are optional unless noted otherwise.

# --- Server ---
# Port for `next start` / `next dev` (default 3000). The Playwright runner navigates to
# http://127.0.0.1:$PORT for relative targets such as /demo-target.
#PORT=3000

# --- Database ---
# Where the libsql/SQLite database lives (default file:./data/rasq.db).
# Use a Turso URL (libsql://…) for hosted SQLite, or an absolute file: path.
#RASQ_DB_URL=file:./data/rasq.db

# --- External agent governance ---
# Per-agent fixed-window mutation budget, per minute (default 120; min 1).
#RASQ_AGENT_RATE_LIMIT=120
# Server-wide per-key daily (UTC) mutation budget; 0 = unlimited (default).
# Can be overridden per key at creation time (npm run agent:key -- --daily-budget N).
#RASQ_AGENT_DAILY_MUTATIONS=0

# --- Retention sweep (audit / webhook deliveries / idempotency / counters) ---
#RASQ_AUDIT_RETENTION_DAYS=180
#RASQ_WEBHOOK_DELIVERY_RETENTION_DAYS=90
#RASQ_IDEMPOTENCY_RETENTION_HOURS=25

# --- Playwright target gate (SSRF guard) ---
# Unset (default): loopback allowed (local /demo-target), other private ranges blocked.
# "1"/"true": all private ranges allowed (trusted LAN). "0"/"false": loopback blocked too.
#RASQ_TARGET_ALLOW_PRIVATE=

# --- Uploads ---
# Recording upload cap in MB (default 100).
#RASQ_MAX_UPLOAD_MB=100

# --- AI providers ---
# Credentials are referenced by env-var NAME only, never stored. The server accepts any
# name on a built-in allowlist of provider keys (OPENAI_API_KEY, ANTHROPIC_API_KEY, …)
# plus any names listed here (comma-separated, upper-case):
#RASQ_PROVIDER_KEY_ENVS=ACME_MODEL_KEY
# Provider base URLs pointing at non-loopback private hosts are rejected by default.
# "1"/"true" permits LAN/private providers (trusted operator), "0" blocks even loopback.
#RASQ_PROVIDERS_ALLOW_PRIVATE=
# Built-in allowlist also honors these (only set the ones you use):
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=
#OPENCODE_API_KEY=

# --- JMeter performance runner ---
# Comma-separated list of EXACT allowed origins for load plans (https or http, no paths).
# No origin is allowed by default; authorize every load target before running.
#RASQ_JMETER_ALLOWED_ORIGINS=http://127.0.0.1:8123

# --- Webhooks ---
# Deliveries to HTTPS receivers only, loopback HTTP excepted. Plain HTTP to non-loopback
# requires "1"/"true" (not recommended); non-public receiver hosts require:
#RASQ_WEBHOOKS_ALLOW_HTTP=
#RASQ_WEBHOOKS_ALLOW_PRIVATE=

# --- MCP server (client-side config; see AGENT_GUIDE.md) ---
# Base URL of the RASQ-Ai server the MCP adapter talks to (default http://127.0.0.1:3000).
#RASQ_AI_URL=http://127.0.0.1:3000
# Operator-issued key for the MCP process (required for `npm run mcp`). Never an operator token.
#RASQ_API_KEY=rasq_…
